---
// Visas när varierar_per_kommun: true. Om användaren har angett kommun i onboarding nämns den.
import { t } from '../i18n/index.js';
---

<aside class="ruta ruta-kommun" data-kommunruta>
  <p class="ruta-rubrik">{t('ruta.kommun.rubrik')}</p>
  <p>{t('ruta.kommun.text')}</p>
  <p data-kommun hidden data-mall={t('ruta.kommun.din', { kommun: '%KOMMUN%' })}></p>
</aside>

<script>
  import { las, NYCKLAR } from '../lib/lagring.js';
  const profil = las(NYCKLAR.profil);
  const kommun = typeof profil?.kommun === 'string' ? profil.kommun.trim() : '';
  if (kommun) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-kommun]')) {
      el.textContent = (el.dataset.mall ?? '').replace('%KOMMUN%', kommun);
      el.hidden = false;
    }
  }
</script>
