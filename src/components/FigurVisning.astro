---
// Visar rätt figur och textversion för ett figur-id. Nya figurer läggs till här.
import Tvattmaskin from '../figurer/tvattmaskin/Tvattmaskin.jsx';
import TvattmaskinText from '../figurer/tvattmaskin/Textversion.astro';
import Brandvarnare from '../figurer/brandvarnare/Brandvarnare.jsx';
import BrandvarnareText from '../figurer/brandvarnare/Textversion.astro';
import Elskap from '../figurer/elskap/Elskap.jsx';
import ElskapText from '../figurer/elskap/Textversion.astro';
import Kyl from '../figurer/kyl/Kyl.jsx';
import KylText from '../figurer/kyl/Textversion.astro';
import Vattenlas from '../figurer/vattenlas/Vattenlas.jsx';
import VattenlasText from '../figurer/vattenlas/Textversion.astro';
import Cistern from '../figurer/cistern/Cistern.jsx';
import CisternText from '../figurer/cistern/Textversion.astro';
import Huvudkran from '../figurer/huvudkran/Huvudkran.jsx';
import HuvudkranText from '../figurer/huvudkran/Textversion.astro';
import Diskmaskin from '../figurer/diskmaskin/Diskmaskin.jsx';
import DiskmaskinText from '../figurer/diskmaskin/Textversion.astro';
import Spis from '../figurer/spis/Spis.jsx';
import SpisText from '../figurer/spis/Textversion.astro';
import Dammsugare from '../figurer/dammsugare/Dammsugare.jsx';
import DammsugareText from '../figurer/dammsugare/Textversion.astro';
import Tavla from '../figurer/tavla/Tavla.jsx';
import TavlaText from '../figurer/tavla/Textversion.astro';
import Paslakan from '../figurer/paslakan/Paslakan.jsx';
import PaslakanText from '../figurer/paslakan/Textversion.astro';
import Cykel from '../figurer/cykel/Cykel.jsx';
import CykelText from '../figurer/cykel/Textversion.astro';
import Faktura from '../figurer/faktura/Faktura.jsx';
import FakturaText from '../figurer/faktura/Textversion.astro';
import Budget from '../figurer/budget/Budget.jsx';
import BudgetText from '../figurer/budget/Textversion.astro';

interface Props {
  id: string;
  del: 'figur' | 'text';
}
const { id, del } = Astro.props;
---

{
  del === 'figur' ? (
    <>
      {id === 'tvattmaskin' && <Tvattmaskin client:visible />}
      {id === 'brandvarnare' && <Brandvarnare client:visible />}
      {id === 'elskap' && <Elskap client:visible />}
      {id === 'kyl' && <Kyl client:visible />}
      {id === 'vattenlas' && <Vattenlas client:visible />}
      {id === 'cistern' && <Cistern client:visible />}
      {id === 'huvudkran' && <Huvudkran client:visible />}
      {id === 'diskmaskin' && <Diskmaskin client:visible />}
      {id === 'spis' && <Spis client:visible />}
      {id === 'dammsugare' && <Dammsugare client:visible />}
      {id === 'tavla' && <Tavla client:visible />}
      {id === 'paslakan' && <Paslakan client:visible />}
      {id === 'cykel' && <Cykel client:visible />}
      {id === 'faktura' && <Faktura client:visible />}
      {id === 'budget' && <Budget client:visible />}
    </>
  ) : (
    <>
      {id === 'tvattmaskin' && <TvattmaskinText />}
      {id === 'brandvarnare' && <BrandvarnareText />}
      {id === 'elskap' && <ElskapText />}
      {id === 'kyl' && <KylText />}
      {id === 'vattenlas' && <VattenlasText />}
      {id === 'cistern' && <CisternText />}
      {id === 'huvudkran' && <HuvudkranText />}
      {id === 'diskmaskin' && <DiskmaskinText />}
      {id === 'spis' && <SpisText />}
      {id === 'dammsugare' && <DammsugareText />}
      {id === 'tavla' && <TavlaText />}
      {id === 'paslakan' && <PaslakanText />}
      {id === 'cykel' && <CykelText />}
      {id === 'faktura' && <FakturaText />}
      {id === 'budget' && <BudgetText />}
    </>
  )
}
