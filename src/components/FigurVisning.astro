---
// Visar rätt figur och textversion för ett figur-id. Nya figurer läggs till här.
import Tvattmaskin from '../figurer/tvattmaskin/Tvattmaskin.jsx';
import TvattmaskinText from '../figurer/tvattmaskin/Textversion.astro';
import Brandvarnare from '../figurer/brandvarnare/Brandvarnare.jsx';
import BrandvarnareText from '../figurer/brandvarnare/Textversion.astro';
import Elskap from '../figurer/elskap/Elskap.jsx';
import ElskapText from '../figurer/elskap/Textversion.astro';
import KylText from '../figurer/kyl/Textversion.astro';
import VattenlasText from '../figurer/vattenlas/Textversion.astro';
import CisternText from '../figurer/cistern/Textversion.astro';
import Huvudkran from '../figurer/huvudkran/Huvudkran.jsx';
import HuvudkranText from '../figurer/huvudkran/Textversion.astro';
import DiskmaskinText from '../figurer/diskmaskin/Textversion.astro';
import SpisText from '../figurer/spis/Textversion.astro';
import DammsugareText from '../figurer/dammsugare/Textversion.astro';
import TavlaText from '../figurer/tavla/Textversion.astro';
import PaslakanText from '../figurer/paslakan/Textversion.astro';
import CykelText from '../figurer/cykel/Textversion.astro';
import FakturaText from '../figurer/faktura/Textversion.astro';
import Budget from '../figurer/budget/Budget.jsx';
import BudgetText from '../figurer/budget/Textversion.astro';
import Stadschema from '../figurer/stadschema/Stadschema.jsx';
import StadschemaText from '../figurer/stadschema/Textversion.astro';
import TvattsymbolerQuiz from '../figurer/tvattsymboler-quiz/TvattsymbolerQuiz.jsx';
import TvattsymbolerQuizText from '../figurer/tvattsymboler-quiz/Textversion.astro';
import KallsorteringQuiz from '../figurer/kallsortering-quiz/KallsorteringQuiz.jsx';
import KallsorteringQuizText from '../figurer/kallsortering-quiz/Textversion.astro';
import Beslutstrad from '../figurer/beslutstrad/Beslutstrad.jsx';
import BeslutstradText from '../figurer/beslutstrad/Textversion.astro';
import { hamtaAmnen } from '../lib/innehall.js';
import { amnenI } from '../figurer/beslutstrad/trad.js';
import { nodnummer } from '../lib/kontakter.js';
import BildFigur from '../figurer/delat/BildFigur.jsx';

interface Props {
  id: string;
  del: 'figur' | 'text';
}
const { id, del } = Astro.props;
// Figurer som består av AI-bilder, ett läge per steg (filer i public/figurer/bilder/<id>/).
const BILDLAGEN: Record<string, string[]> = {"kyl": ["stangd", "oppen", "oppen-mat", "frys-ute"], "cistern": ["grund", "spolar", "fylls", "lacker"], "diskmaskin": ["stangd", "oppen", "korg-ute", "filter"], "dammsugare": ["grund", "oppen", "munstycken", "filter"], "paslakan": ["steg1", "steg2", "steg3", "klar"], "cykel": ["grund", "punktering", "pump", "kedja"], "vattenlas": ["grund", "torr", "loss"], "spis": ["grund", "kastrull", "ugn-oppen"], "tavla": ["gips", "betong", "tra"], "faktura": ["grund"]};
const alla = id === 'beslutstrad' ? await hamtaAmnen() : [];
const titlar = Object.fromEntries(amnenI().map((a) => [a, alla.find((p) => p.data.id === a)?.data.titel ?? a]));
---

{
  del === 'figur' ? (
    <>
      {BILDLAGEN[id] && <BildFigur client:visible id={id} lagen={BILDLAGEN[id]} />}
      {id === 'tvattmaskin' && <Tvattmaskin client:visible />}
      {id === 'brandvarnare' && <Brandvarnare client:visible />}
      {id === 'elskap' && <Elskap client:visible />}
      {id === 'huvudkran' && <Huvudkran client:visible />}
      {id === 'budget' && <Budget client:visible />}
      {id === 'stadschema' && <Stadschema client:visible />}
      {id === 'tvattsymboler-quiz' && <TvattsymbolerQuiz client:visible />}
      {id === 'kallsortering-quiz' && <KallsorteringQuiz client:visible />}
      {id === 'beslutstrad' && <Beslutstrad client:visible valbar nodnummer={nodnummer()} titlar={titlar} />}
    </>
  ) : (
    <>
      {id === 'tvattmaskin' && <TvattmaskinText />}
      {id === 'brandvarnare' && <BrandvarnareText />}
      {id === 'elskap' && <ElskapText />}
      {id === 'kyl' && <KylText />}
      {id === 'vattenlas' && <VattenlasText />}
      {id === 'cistern' && <CisternText />}
      {id === 'huvudkran' && <HuvudkranText />}
      {id === 'diskmaskin' && <DiskmaskinText />}
      {id === 'spis' && <SpisText />}
      {id === 'dammsugare' && <DammsugareText />}
      {id === 'tavla' && <TavlaText />}
      {id === 'paslakan' && <PaslakanText />}
      {id === 'cykel' && <CykelText />}
      {id === 'faktura' && <FakturaText />}
      {id === 'budget' && <BudgetText />}
      {id === 'stadschema' && <StadschemaText />}
      {id === 'tvattsymboler-quiz' && <TvattsymbolerQuizText />}
      {id === 'kallsortering-quiz' && <KallsorteringQuizText />}
      {id === 'beslutstrad' && <BeslutstradText />}
    </>
  )
}
