---
// Numrerad lista över figurerna. På bred skärm en kolumn bredvid figuren, på mobil en vågrät rad.
import { t } from '../i18n/index.js';
import { FIGURER } from '../data/figurer.js';
import { figurUrl } from '../lib/innehall.js';

interface Props {
  aktiv?: string;
}
const { aktiv } = Astro.props;
---

<nav class="figurlista" aria-label={t('figurer.lista')}>
  <ul>
    {
      FIGURER.map((f, i) => (
        <li>
          <a href={figurUrl(f.id)} aria-current={f.id === aktiv ? 'page' : undefined} class:list={{ kommer: !f.klar }}>
            <span class="nr mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="namn">{f.titel}</span>
            {!f.klar && <span class="visuellt-dold">, {t('figurer.kommer')}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    /* Positionerad så att de dolda texterna för skärmläsare stannar inne i rullningen och inte gör sidan bredare. */
    position: relative;
    display: flex;
    gap: var(--steg-1);
    overflow-x: auto;
    list-style: none;
    padding: 0 0 var(--steg-2);
    margin: 0;
    scrollbar-width: thin;
  }
  a {
    display: flex;
    align-items: baseline;
    gap: var(--steg-2);
    white-space: nowrap;
    padding: var(--steg-2) var(--steg-3);
    border-radius: var(--radie-s);
    color: var(--black);
    text-decoration: none;
    line-height: 1.3;
  }
  a:hover {
    background: var(--yta-2);
  }
  a.kommer {
    color: var(--text-svag);
  }
  a[aria-current='page'] {
    background: var(--black);
    color: var(--papper);
  }
  .nr {
    opacity: 0.7;
  }
  @media (min-width: 1000px) {
    nav {
      position: sticky;
      top: var(--steg-4);
    }
    ul {
      flex-direction: column;
      overflow: visible;
    }
    a {
      white-space: normal;
    }
  }
</style>
