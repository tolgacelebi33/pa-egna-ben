---
import Bas from '../../layouts/Bas.astro';
import AmneKort from '../../components/AmneKort.astro';
import Filtrering from '../../components/Filtrering.astro';
import { t } from '../../i18n/index.js';
import { url } from '../../lib/url.js';
import { KATEGORIER } from '../../data/kategorier.js';
import { amnenIKategori } from '../../lib/innehall.js';
import { NIVAER } from '../../lib/schema.js';

export function getStaticPaths() {
  return KATEGORIER.map((k) => ({ params: { id: k.id }, props: { kat: k } }));
}

const { kat } = Astro.props;
const amnen = await amnenIKategori(kat.id);
const grupper = NIVAER.map((n) => ({ niva: n, amnen: amnen.filter((p) => p.data.niva === n) })).filter(
  (g) => g.amnen.length > 0,
);
---

<Bas titel={kat.titel} bred>
  <nav class="bradsmulor" aria-label={t('brodsmulor')}>
    <ol>
      <li><a href={url()}>{t('meny.start')}</a></li>
    </ol>
  </nav>
  <header class="kategorihuvud">
    <span class="mono">{t('kategori.over')} · {amnen.length === 1 ? t('antal.amne') : t('antal.amnen', { antal: amnen.length })}</span>
    <h1>{kat.titel}</h1>
    {kat.regel && <p class="ingress">{kat.regel}</p>}
  </header>

  <Filtrering />

  {amnen.length === 0 && <p>{t('inga.amnen')}</p>}
  {
    grupper.map((g) => (
      <section aria-labelledby={`niva-${g.niva}`}>
        <h2 id={`niva-${g.niva}`} class="nivarubrik">
          {t(`niva.${g.niva}`)}
        </h2>
        <ul class="kortlista rutnat">
          {g.amnen.map((p) => (
            <AmneKort data={p.data} visaNiva={false} />
          ))}
        </ul>
      </section>
    ))
  }
</Bas>

<style>
  .kategorihuvud {
    margin: var(--steg-4) 0 var(--steg-5);
    max-width: 44rem;
  }
  .kategorihuvud .mono {
    color: var(--text-svag);
  }
  .kategorihuvud h1 {
    margin: var(--steg-2) 0 var(--steg-3);
  }
  .nivarubrik {
    font-size: var(--text-l);
    margin: var(--steg-6) 0 var(--steg-3);
  }
</style>
