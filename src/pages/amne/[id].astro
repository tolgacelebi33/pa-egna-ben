---
import { render } from 'astro:content';
import Bas from '../../layouts/Bas.astro';
import Akut from '../../components/Akut.astro';
import VarierarPerKommun from '../../components/VarierarPerKommun.astro';
import Kallor from '../../components/Kallor.astro';
import Granskning from '../../components/Granskning.astro';
import AmneKort from '../../components/AmneKort.astro';
import { t } from '../../i18n/index.js';
import { url } from '../../lib/url.js';
import { hamtaAmnen, arUtkast, kategoriUrl, figurUrl, VISA_UTKAST } from '../../lib/innehall.js';
import { kategori } from '../../data/kategorier.js';
import { figur } from '../../data/figurer.js';
import { CONFIG } from '../../config.js';

export async function getStaticPaths() {
  const amnen = await hamtaAmnen();
  return amnen.map((post) => ({ params: { id: post.data.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const kat = kategori(d.kategori);
const fig = d.figur ? figur(d.figur) : null;
const alla = await hamtaAmnen();
const relaterade = d.relaterade.map((id) => alla.find((p) => p.data.id === id)).filter(Boolean);
const utkast = arUtkast(d);

const sidUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://example.invalid').pathname;
const rapport = `mailto:${CONFIG.felrapportEpost}?subject=${encodeURIComponent(
  t('amne.rapportera.amne', { titel: d.titel, id: d.id }),
)}&body=${encodeURIComponent(t('amne.rapportera.text', { titel: d.titel, id: d.id, url: sidUrl }))}`;
---

<Bas titel={d.titel} beskrivning={d.sammanfattning || undefined}>
  <nav class="bradsmulor" aria-label={t('brodsmulor')}>
    <ol>
      <li><a href={url()}>{t('meny.start')}</a></li>
      <li><a href={kategoriUrl(d.kategori)}>{kat?.titel}</a></li>
    </ol>
  </nav>

  <article>
    <header class="amneshuvud">
      <span class="mono">{kat?.titel}</span>
      <h1>{d.titel}</h1>
      {d.sammanfattning && <p class="ingress">{d.sammanfattning}</p>}
      <ul class="etiketter">
        {d.akut && <li class="etikett akut">{t('akut.etikett')}</li>}
        <li class="etikett">{t(`niva.${d.niva}`)}</li>
        {utkast && <li class="etikett utkast">{t('utkast.markering')}</li>}
      </ul>
    </header>

    {
      utkast && (
        <aside class="ruta ruta-utkast">
          <p class="ruta-rubrik">{t('utkast.markering')}</p>
          <p>{t('utkast.text')}</p>
        </aside>
      )
    }

    {d.akut && <Akut />}
    {d.varierar_per_kommun && <VarierarPerKommun />}

    {
      fig?.klar && (
        <a class="figurlank ark" href={figurUrl(fig.id)}>
          <img src={url(`figurer/${fig.id}.jpg`)} alt="" width="600" height="420" />
          <span>
            <span class="mono">{t('amne.figur.rubrik')}</span>
            <span class="figurlank-titel">{fig.titel}</span>
            <span class="figurlank-text">{t('amne.figur.text')}</span>
          </span>
        </a>
      )
    }

    <div class="brodtext ark">
      <Content />
      {fig && !fig.klar && <p class="mono kommer">{t('amne.figur.kommer')}</p>}
    </div>

    <div class="fakta">
      <Kallor kallor={d.kallor} kalltyper={d.kalltyper} visaKalltyper={VISA_UTKAST} />
      <Granskning granskning={d.granskning} risk={d.risk} />
    </div>

    {
      relaterade.length > 0 && (
        <section aria-labelledby="relaterade-rubrik">
          <h2 id="relaterade-rubrik">{t('amne.relaterade')}</h2>
          <ul class="kortlista">
            {relaterade.map((p) => (
              <AmneKort data={p!.data} />
            ))}
          </ul>
        </section>
      )
    }

    <p class="inte-utskrift"><a href={rapport}>{t('amne.rapportera')}</a></p>
  </article>
</Bas>

<style>
  .amneshuvud {
    margin: var(--steg-4) 0 var(--steg-5);
  }
  .amneshuvud .mono {
    color: var(--text-svag);
  }
  .amneshuvud h1 {
    margin: var(--steg-2) 0 var(--steg-3);
  }
  .brodtext {
    margin: var(--steg-5) 0;
  }
  .brodtext :global(h2) {
    font-size: var(--text-l);
    margin: var(--steg-5) 0 var(--steg-2);
  }
  .brodtext :global(h2:first-child) {
    margin-top: 0;
  }
  .kommer {
    color: var(--text-svag);
    margin-bottom: 0;
  }
  .figurlank {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    align-items: center;
    gap: var(--steg-4);
    padding: var(--steg-3);
    margin: var(--steg-5) 0;
    color: var(--black);
    text-decoration: none;
    border: 1.5px solid transparent;
  }
  .figurlank:hover {
    border-color: var(--black);
  }
  .figurlank img {
    width: 100%;
    height: auto;
    border-radius: var(--radie);
    background: var(--figurpapper);
  }
  .figurlank > span {
    display: grid;
    gap: var(--steg-1);
  }
  .figurlank .mono {
    color: var(--text-svag);
  }
  .figurlank-titel {
    font-family: var(--typsnitt-rubrik);
    font-weight: 700;
    font-size: var(--text-l);
  }
  .figurlank-text {
    color: var(--text-svag);
    font-size: var(--text-s);
  }
  .fakta {
    display: grid;
    gap: 0 var(--steg-4);
  }
  @media (min-width: 720px) {
    .fakta {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .brodtext :global(li) {
    margin-bottom: var(--steg-1);
  }
  .brodtext :global(ol > li::marker) {
    font-weight: 700;
  }
</style>
