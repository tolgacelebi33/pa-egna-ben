---
import Bas from '../../layouts/Bas.astro';
import AmneKort from '../../components/AmneKort.astro';
import Figurlista from '../../components/Figurlista.astro';
import Tvattmaskin3D from '../../figurer/tvattmaskin/Tvattmaskin3D.jsx';
import TvattmaskinText from '../../figurer/tvattmaskin/Textversion.astro';
import Brandvarnare from '../../figurer/brandvarnare/Brandvarnare.jsx';
import BrandvarnareText from '../../figurer/brandvarnare/Textversion.astro';
import Elskap from '../../figurer/elskap/Elskap.jsx';
import ElskapText from '../../figurer/elskap/Textversion.astro';
import { t } from '../../i18n/index.js';
import { FIGURER } from '../../data/figurer.js';
import { hamtaAmnen } from '../../lib/innehall.js';

export function getStaticPaths() {
  return FIGURER.map((f, i) => ({ params: { id: f.id }, props: { fig: f, nr: i + 1 } }));
}

const { fig, nr } = Astro.props;
const amnen = (await hamtaAmnen()).filter((p) => p.data.figur === fig.id);
const nummer = String(nr).padStart(2, '0');
---

<Bas titel={fig.titel} bred>
  <div class="figurvy">
    <Figurlista aktiv={fig.id} />

    <article class="figurark ark" aria-labelledby="figur-rubrik">
      <header class="figurhuvud">
        <span class="mono">{t('figurer.figur')} {nummer}</span>
        <h1 id="figur-rubrik">{fig.titel}</h1>
      </header>

      {!fig.klar && <p class="ingress">{t('figurer.inte.klar')}</p>}
      {fig.id === 'tvattmaskin' && <Tvattmaskin3D client:visible />}
      {fig.id === 'brandvarnare' && <Brandvarnare client:visible />}
      {fig.id === 'elskap' && <Elskap client:visible />}

      {
        fig.klar && (
          <section class="textversion" aria-labelledby="textversion-rubrik">
            <span class="mono">{t('figurer.text.over')}</span>
            <h2 id="textversion-rubrik">{t('figurer.text.rubrik')}</h2>
            {fig.id === 'tvattmaskin' && <TvattmaskinText />}
            {fig.id === 'brandvarnare' && <BrandvarnareText />}
            {fig.id === 'elskap' && <ElskapText />}
          </section>
        )
      }
    </article>
  </div>

  {
    amnen.length > 0 && (
      <section class="figuramnen" aria-labelledby="figur-amnen">
        <h2 id="figur-amnen">{t('figurer.amnen')}</h2>
        <ul class="kortlista rutnat">
          {amnen.map((p) => (
            <AmneKort data={p.data} />
          ))}
        </ul>
      </section>
    )
  }
</Bas>

<style>
  /* minmax(0, ...) så att den vågräta figurlistan inte kan trycka ut sidan på mobil (fel från fas 0).
     ".figurvy > *" räcker inte, eftersom Astros avgränsade stilar inte når barn från andra komponenter. */
  .figurvy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--steg-4);
    margin-top: var(--steg-4);
  }
  .figurhuvud {
    display: flex;
    flex-direction: column;
    gap: var(--steg-1);
    margin-bottom: var(--steg-4);
  }
  .figurhuvud h1 {
    margin: 0;
    font-size: var(--text-xl);
  }
  @media (max-width: 640px) {
    .figurark {
      margin-inline: calc(-1 * var(--steg-2));
    }
    .figurhuvud {
      margin-bottom: var(--steg-3);
    }
  }
  .figurhuvud .mono {
    color: var(--text-svag);
  }
  .textversion {
    margin-top: var(--steg-7);
    padding-top: var(--steg-5);
    border-top: 1px solid var(--linje);
    max-width: var(--max-bredd);
  }
  .textversion .mono {
    color: var(--text-svag);
  }
  .textversion h2 {
    margin-top: var(--steg-1);
  }
  @media (min-width: 1000px) {
    .figurvy {
      grid-template-columns: 220px minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
