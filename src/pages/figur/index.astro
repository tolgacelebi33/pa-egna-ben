---
import Bas from '../../layouts/Bas.astro';
import { t } from '../../i18n/index.js';
import { FIGURER } from '../../data/figurer.js';
import { figurUrl } from '../../lib/innehall.js';
import { url } from '../../lib/url.js';
---

<Bas titel={t('figurer.rubrik')} bred>
  <h1>{t('figurer.rubrik')}</h1>
  <p class="ingress">{t('figurer.ingress')}</p>
  <ul class="kortlista rutnat">
    {
      FIGURER.map((f) => (
        <li>
          <a class="kort figurbild" href={figurUrl(f.id)}>
            {f.klar && <img src={url(`figurer/${f.id}.jpg`)} alt="" width="600" height="420" loading="lazy" decoding="async" />}
            <span class="kort-titel">{f.titel}</span>
            {!f.klar && <span class="kort-text">{t('figurer.kommer')}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</Bas>

<style>
  .figurbild img {
    width: 100%;
    height: auto;
    aspect-ratio: 10 / 7;
    object-fit: cover;
    border-radius: var(--radie-s);
    background: var(--figurpapper);
    margin-bottom: var(--steg-2);
  }
</style>
